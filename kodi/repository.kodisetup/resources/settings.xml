<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="repository.kodisetup">
    <category id="general" label="General">
      <group id="1">
        <setting id="manifest_url" type="string" label="Signed manifest URL">
          <default>https://github.com/rjclark99/starlanemeridian/releases/latest/download/manifest.json</default>
          <constraints><allowempty>false</allowempty></constraints>
          <control type="edit" format="string" />
        </setting>
        <setting id="public_key" type="string" label="Ed25519 public key (base64url)">
          <default>CvpCWgdzUG-U-nLnyaM00pzcRLx-FtYhtN3wU2zeKKc</default>
          <control type="edit" format="string" />
        </setting>
        <setting id="applied_version" type="string" label="Applied configuration" help="Read-only setup state">
          <default>unapplied</default>
          <control type="edit" format="string"><enabled>false</enabled></control>
        </setting>
        <setting id="installation_authorized" type="boolean" label="Legacy package authorization (unused)" help="Retained only for settings compatibility">
          <default>false</default>
          <control type="toggle"><enabled>false</enabled></control>
        </setting>
        <setting id="authorized_scope" type="string" label="Authorized package scope" help="Internal scope-bound consent state">
          <default>__unset__</default><control type="edit" format="string"><enabled>false</enabled></control>
        </setting>
        <setting id="applied_scope" type="string" label="Applied package scope" help="Internal verified completion state">
          <default>__unset__</default><control type="edit" format="string"><enabled>false</enabled></control>
        </setting>
        <setting id="revoke_installation_authorization" type="action" label="Revoke future package authorization" help="Require fresh local consent before any future package changes">
          <level>0</level>
          <data>RunScript(repository.kodisetup,revoke-consent)</data>
          <control type="button" format="action"><close>true</close></control>
        </setting>
        <setting id="pending_skin" type="string" label="Pending skin activation" help="Internal recovery state">
          <default>__unset__</default><control type="edit" format="string"><enabled>false</enabled></control>
        </setting>
        <setting id="previous_skin" type="string" label="Previous skin" help="Internal recovery state">
          <default>__unset__</default><control type="edit" format="string"><enabled>false</enabled></control>
        </setting>
      </group>
    </category>
  </section>
</settings>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Starlane specialist result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "outcome", "finding_or_change", "evidence", "changed_paths",
    "focused_validation", "full_validation", "unresolved_risks",
    "authority_or_approval_used", "recommended_next_action"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "outcome": {"enum": ["complete", "blocked", "needs_review"]},
    "finding_or_change": {"type": "string", "minLength": 5, "maxLength": 2000},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "focused_validation": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "full_validation": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "authority_or_approval_used": {"type": "string", "minLength": 3, "maxLength": 500},
    "recommended_next_action": {"type": "string", "minLength": 3, "maxLength": 800}
  }
}
